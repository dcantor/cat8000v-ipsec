{#- Intended configuration for the C8000v IPsec VTI routers, rendered from Nautobot (query golden-config-lab).
    Features under compliance: management ACL, static routes, loopbacks, wan-interface, tunnel, crypto (incl. the PKI trustpoint and
    certificate map when IKE authenticates with certificates), BGP, banner. -#}
{%- set masks = {'24': '255.255.255.0', '30': '255.255.255.252', '32': '255.255.255.255'} -%}
{#- crypto suite from the VPN profile of this router's tunnel endpoints (core vpn app); Cisco names in extra_options.ios -#}
{%- set ns = namespace(prof=none) -%}
{%- for i in interfaces if i.vpn_tunnel_endpoints_tunnel %}{% set ns.prof = i.vpn_tunnel_endpoints_tunnel.vpn_profile %}{% endfor -%}
{%- set prof = ns.prof -%}
{%- set ios = prof.extra_options.ios -%}
{%- set p1 = prof.vpn_phase1_policies[0] -%}
{%- set p2 = prof.vpn_phase2_policies[0] -%}
{%- set ike_enc = {'AES_256_CBC': 'aes-cbc-256', 'AES_192_CBC': 'aes-cbc-192', 'AES_128_CBC': 'aes-cbc-128', 'AES_256_GCM': 'aes-gcm-256', 'AES_128_GCM': 'aes-gcm-128'} -%}
{%- set esp_enc = {'AES_256_CBC': 'esp-aes 256', 'AES_192_CBC': 'esp-aes 192', 'AES_128_CBC': 'esp-aes', 'AES_256_GCM': 'esp-gcm 256', 'AES_128_GCM': 'esp-gcm'} -%}
{%- set esp_hmac = {'SHA256': 'esp-sha256-hmac', 'SHA384': 'esp-sha384-hmac', 'SHA512': 'esp-sha512-hmac', 'SHA1': 'esp-sha-hmac', 'MD5': 'esp-md5-hmac'} -%}
{%- set encap = {'IPSEC_TUNNEL': 'ipsec ipv4', 'GRE': 'gre ip'} -%}
hostname {{ hostname }}
!
{% for va in vrf_assignments | sort(attribute='vrf.name') %}
vrf definition {{ va.vrf.name }}
 !
 address-family ipv4
 exit-address-family
!
{% endfor %}
ip domain name {{ config_context.domain_name }}
!
ip route vrf {{ config_context.oob.vrf }} 0.0.0.0 0.0.0.0 {{ config_context.oob.gateway }}
{#- static routes through a firewall: one per tunnel towards the far endpoint's source address (headend: the spoke's /30,
    spoke: the headend's WAN /32), next hop = the firewall's address on this router's WAN link #}
{%- set routes = [] %}
{%- for i in interfaces if i.vpn_tunnel_endpoints_tunnel %}
{%-   set ep = i.vpn_tunnel_endpoints_tunnel %}
{%-   set tun = (ep.endpoint_a_vpn_tunnels + ep.endpoint_z_vpn_tunnels) | first %}
{%-   set far = tun.endpoint_z if ep.endpoint_a_vpn_tunnels else tun.endpoint_a %}
{%-   set srcname = ep.source_interface.name if ep.source_interface else ep.source_ipaddress.interfaces[0].name %}
{%-   set src = (interfaces | selectattr('name', 'equalto', srcname) | list | first) %}
{%-   if src and src.connected_interface and src.connected_interface.device.role.name == 'vpn-firewall' and src.connected_interface.ip_addresses %}
{%-     set via = src.connected_interface.ip_addresses[0].address.split('/')[0] %}
{%-     set faddr = far.source_ipaddress.address %}
{%-     if ep.role and ep.role.name == 'hub' %}
{%-       set net = (faddr | ipaddress_interface('network') | string) | ipaddress_network('network_address') ~ ' ' ~ masks[faddr.split('/')[1]] %}
{%-     else %}
{%-       set net = faddr.split('/')[0] ~ ' 255.255.255.255' %}
{%-     endif %}
{%-     set line = 'ip route ' ~ net ~ ' ' ~ via ~ ' name via-' ~ src.connected_interface.device.name %}
{%-     if line not in routes %}{% set _ = routes.append(line) %}{% endif %}
{%-   endif %}
{%- endfor +%}
{% for r in routes | sort %}
{{ r }}
{% endfor %}
!
ip access-list standard {{ config_context.oob.acl }}
 10 remark OOB management network
 20 permit {{ config_context.oob.prefix | ipaddress_network('network_address') }} {{ config_context.oob.prefix | ipaddress_network('hostmask') }}
 30 deny any log
!
{% for i in interfaces | sort(attribute='name') if i.name.startswith('Loopback') and i.ip_addresses %}
interface {{ i.name }}
 description {{ i.description }}
 ip address {{ i.ip_addresses[0].address.split('/')[0] }} {{ masks[i.ip_addresses[0].address.split('/')[1]] }}
!
{% endfor %}
{% for i in interfaces | sort(attribute='name') if i.name.startswith('GigabitEthernet') and i.name != 'GigabitEthernet1' %}
interface {{ i.name }}
{% if i.enabled and i.ip_addresses %}
 description {{ i.description }}
 ip address {{ i.ip_addresses[0].address.split('/')[0] }} {{ masks[i.ip_addresses[0].address.split('/')[1]] }}
 negotiation auto
 cdp enable
{% else %}
 no ip address
 shutdown
 negotiation auto
{% endif %}
!
{% endfor %}
{% for i in interfaces | sort(attribute='name') if i.name.startswith('Tunnel') and i.ip_addresses and i.vpn_tunnel_endpoints_tunnel %}
{% set ep = i.vpn_tunnel_endpoints_tunnel %}
{% set tun = (ep.endpoint_a_vpn_tunnels + ep.endpoint_z_vpn_tunnels) | first %}
{% set far = tun.endpoint_z if ep.endpoint_a_vpn_tunnels else tun.endpoint_a %}
interface {{ i.name }}
 description {{ i.description }}
 ip address {{ i.ip_addresses[0].address.split('/')[0] }} {{ masks[i.ip_addresses[0].address.split('/')[1]] }}
 ip mtu 1400
 ip tcp adjust-mss 1360
 tunnel source {{ ep.source_interface.name if ep.source_interface else ep.source_ipaddress.interfaces[0].name }}
 tunnel mode {{ encap[tun.encapsulation | upper | replace('-', '_')] }}
 tunnel destination {{ far.source_ipaddress.address.split('/')[0] }}
 tunnel protection ipsec profile {{ ep.vpn_profile.extra_options.ios.ipsec_profile }}
!
{% endfor %}
crypto ikev2 proposal {{ ios.ikev2_proposal }}
 encryption{% for e in p1.encryption_algorithm %} {{ ike_enc[e | upper | replace('-', '_')] }}{% endfor +%}
 integrity {{ p1.integrity_algorithm | map('lower') | join(' ') }}
 group {{ p1.dh_group | join(' ') }}
!
crypto ikev2 policy {{ ios.ikev2_policy }}
 proposal {{ ios.ikev2_proposal }}
!
{# one IKEv2 / IPsec profile per authentication method this router's tunnels use (each spoke chooses; a headend serves both):
    the profiles of this router's endpoints, in name order, with the far ends that ride on each -#}
{% set pm = namespace(profiles={}) -%}
{% for i in interfaces if i.vpn_tunnel_endpoints_tunnel %}{% set ep = i.vpn_tunnel_endpoints_tunnel %}{% set tun = (ep.endpoint_a_vpn_tunnels + ep.endpoint_z_vpn_tunnels) | first -%}
{% set far = tun.endpoint_z if ep.endpoint_a_vpn_tunnels else tun.endpoint_a -%}
{% set _ = pm.profiles.update({ep.vpn_profile.name: {'prof': ep.vpn_profile, 'peers': (pm.profiles.get(ep.vpn_profile.name, {}).get('peers', []) + [far.source_ipaddress.address.split('/')[0]])}}) %}{% endfor -%}
{% set certs = pm.profiles.values() | map(attribute='prof') | selectattr('vpn_phase1_policies.0.authentication_method', 'equalto', 'RSA') | list -%}
{% if certs %}
{#- certificates from the lab CA: the trustpoint (nautobot/pki.py enrols it; the CA fingerprint is pinned), the map the peers are matched on #}
{% set cios = certs[0].extra_options.ios -%}
crypto pki trustpoint {{ cios.trustpoint }}
 enrollment terminal pem
 fqdn {{ hostname }}.{{ config_context.domain_name }}
 fingerprint {{ cios.ca_fingerprint }}
 subject-name CN={{ hostname }}.{{ config_context.domain_name }},O=cat8000v-ipsec
 subject-alt-name {{ hostname }}.{{ config_context.domain_name }}
 revocation-check none
 rsakeypair {{ cios.rsakeypair }}
 hash sha256
!
crypto pki certificate map {{ cios.certificate_map }} 10
 issuer-name co {{ cios.ca_subject.split(',')[0].split('=')[1] | lower }}
!
{% endif %}
{% for pname in pm.profiles | sort %}{% set pp = pm.profiles[pname].prof %}{% set pios = pp.extra_options.ios %}
crypto ikev2 profile {{ pios.ikev2_profile }}
{% if pp.vpn_phase1_policies[0].authentication_method == 'RSA' %}
 match certificate {{ pios.certificate_map }}
 identity local dn
 authentication remote rsa-sig
 authentication local rsa-sig
 pki trustpoint {{ pios.trustpoint }}
{% else %}
{% for peer in pm.profiles[pname].peers | sort %}
 match identity remote address {{ peer }} 255.255.255.255
{% endfor %}
 authentication remote pre-share
 authentication local pre-share
 keyring local {{ pios.ikev2_keyring }}
{% endif %}
{% if pp.keepalive_enabled %}
 dpd {{ pp.keepalive_interval }} {{ pp.keepalive_retries }} on-demand
{% endif %}
!
{% endfor %}
crypto ipsec transform-set {{ ios.transform_set }} {{ esp_enc[p2.encryption_algorithm[0] | upper | replace('-', '_')] }} {{ esp_hmac[p2.integrity_algorithm[0] | upper] }}
 mode tunnel
!
{% for pname in pm.profiles | sort %}{% set pios = pm.profiles[pname].prof.extra_options.ios %}
crypto ipsec profile {{ pios.ipsec_profile }}
 set transform-set {{ pios.transform_set }}
 set ikev2-profile {{ pios.ikev2_profile }}
!
{% endfor %}
{% set own = [] %}
{% for i in interfaces %}{% for ip in i.ip_addresses if ip.parent %}{% for t in ip.parent.tags if t.name == 'bgp:advertise' and ip.parent.prefix not in own %}{% set _ = own.append(ip.parent.prefix) %}{% endfor %}{% endfor %}{% endfor %}
{% for ri in bgp_routing_instances %}
router bgp {{ ri.autonomous_system.asn }}
 bgp router-id {{ ri.router_id.address.split('/')[0] }}
 bgp log-neighbor-changes
{% for ep in ri.endpoints | sort(attribute='peer.source_ip.address') if ep.enabled and ep.peer %}
 neighbor {{ ep.peer.source_ip.address.split('/')[0] }} remote-as {{ ep.peer.autonomous_system.asn }}
 neighbor {{ ep.peer.source_ip.address.split('/')[0] }} description {{ ep.description }}
{% endfor %}
 !
 address-family ipv4
{% set lo = [] %}{% set nets = [] %}
{% for p in own %}{% if p.endswith('/32') %}{% set _ = lo.append(p) %}{% else %}{% set _ = nets.append(p) %}{% endif %}{% endfor %}
{% for p in lo + (nets | sort) %}
{% if p.endswith('/24') and p.startswith('192.') %}
  network {{ p.split('/')[0] }}
{% else %}
  network {{ p.split('/')[0] }} mask {{ masks[p.split('/')[1]] }}
{% endif %}
{% endfor %}
{% for ep in ri.endpoints | sort(attribute='peer.source_ip.address') if ep.enabled and ep.peer %}
  neighbor {{ ep.peer.source_ip.address.split('/')[0] }} activate
{% endfor %}
 exit-address-family
!
{% endfor %}
banner motd ^CC8000v IPsec VTI lab - managed by Network-as-Code (Terraform).^C
